# Ask Ambedkar — Environment Configuration Template
# Copy this file to .env.local for local development

# ---------------------------------------------------------------------------
# Core Application Settings
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Ask Ambedkar"
NEXT_PUBLIC_APP_TAGLINE="Ask anything. Discover what Ambedkar wrote."

# ---------------------------------------------------------------------------
# Anonymous Session & Rate Limiting (Future Segments)
# ---------------------------------------------------------------------------
# SESSION_SECRET=change-this-in-production-session-secret-key
# RATE_LIMIT_MAX_REQUESTS_PER_MINUTE=20

# ---------------------------------------------------------------------------
# Database & Storage (Future Segments)
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://user:password@localhost:5432/ask_ambedkar

# ---------------------------------------------------------------------------
# Retrieval & Vector Database (Future Segments)
# ---------------------------------------------------------------------------
# VECTOR_STORE_PROVIDER=local
# VECTOR_STORE_COLLECTION=ambedkar_primary_sources

# ---------------------------------------------------------------------------
# LLM / Answer Generation (Future Segments)
# ---------------------------------------------------------------------------
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
